# ==============================================================================
# Elastic Stack Observability - Environment Variables
# ==============================================================================

# Ambiente de execução
ENVIRONMENT=prod

# Versão do Elastic Stack (Elasticsearch, Kibana, Logstash, Beats)
ELASTIC_VERSION=8.13.0

# Segurança básica do Elasticsearch
ELASTIC_SECURITY_ENABLED=false

# Alocação de memória Heap JVM para Elasticsearch e Logstash (Recomendado: 512m a 2g de acordo com a VPS)
ES_HEAP=512m
LS_HEAP=512m

# Portas dos Serviços
ES_PORT=9200
KIBANA_PORT=5601
LOGSTASH_PORT=5044

# Nome da rede docker externa padrão compartilhada com os microsserviços
APP_NETWORK_NAME=app-network

# ==============================================================================
# Configurações de Notificação para Telegram (Passados via Secret / APP_SECRETS)
# ==============================================================================

# Endpoint da API do Telegram (Default: https://api.telegram.org)
TELEGRAM_ENDPOINT=https://api.telegram.org

# Token gerado pelo @BotFather (ex: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=

# Chat ID ou Group/Channel ID (ex: -1001234567890)
TELEGRAM_CHAT_ID=
