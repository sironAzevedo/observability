# ==============================================================================
# Elastic Stack Observability - Environment Variables
# ==============================================================================

# Ambiente de execução (dev, prod)
ENVIRONMENT=prod

# Versão do Elastic Stack (Elasticsearch, Kibana, Logstash, Beats, APM)
ELASTIC_VERSION=8.13.0

# Segurança básica do Elasticsearch e Kibana (Autenticação por Usuário/Senha)
ELASTIC_SECURITY_ENABLED=true
ELASTIC_USER=elastic
ELASTIC_PASSWORD=elastic123

# Chaves de Criptografia do Kibana para Alertas e Conectores (mínimo 32 caracteres)
# Necessário para habilitar Alerting & Actions (Telegram Webhook Connector)
KIBANA_ENCRYPTION_KEY=observability_kibana_encryption_key_secret_32char_min

# Alocação de memória Heap JVM para Elasticsearch e Logstash (Recomendado: 512m a 2g de acordo com a VPS)
ES_HEAP=512m
LS_HEAP=512m

# Portas dos Serviços
ES_PORT=9200
KIBANA_PORT=5601
LOGSTASH_PORT=5044
APM_PORT=8200

# Nome da rede docker externa padrão compartilhada com os microsserviços
APP_NETWORK_NAME=app-network

# ==============================================================================
# Configurações de Notificação para Telegram (Passados via Secret / APP_SECRETS)
# ==============================================================================

# Endpoint da API do Telegram (Default: https://api.telegram.org)
TELEGRAM_ENDPOINT=https://api.telegram.org

# Token gerado pelo @BotFather (ex: 123456789:ABCdefGHIjklMNOpqrSTUvwxYZ)
TELEGRAM_BOT_TOKEN=

# Chat ID ou Group/Channel ID (ex: -1001234567890)
TELEGRAM_CHAT_ID=
